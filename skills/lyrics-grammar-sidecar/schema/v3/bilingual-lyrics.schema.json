{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sakurauta.app/schemas/lyrics-grammar-bilingual-lyrics/v1.json",
  "title": "Bilingual Lyrics Input v1",
  "description": "Timestamp-free, filtered bilingual source lines handed off to lyrics-grammar-sidecar.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schemaVersion",
    "lineCount",
    "contentHash",
    "lines"
  ],
  "properties": {
    "schema": {"const": "sakurauta.bilingual-lyrics"},
    "schemaVersion": {"const": 1},
    "sourceLanguages": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]+)*$"}
    },
    "learnerLanguage": {
      "type": "string",
      "pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]+)*$"
    },
    "lineCount": {"type": "integer", "minimum": 1},
    "contentHash": {"$ref": "#/$defs/hash"},
    "lines": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/line"}
    }
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{2,63}$"},
    "line": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lineId", "sourceOrder", "text", "fingerprint", "translation"],
      "properties": {
        "lineId": {"$ref": "#/$defs/id"},
        "sourceOrder": {"type": "integer", "minimum": 0},
        "text": {"type": "string", "minLength": 1},
        "fingerprint": {"$ref": "#/$defs/hash"},
        "translation": {"type": ["string", "null"]}
      }
    }
  }
}
